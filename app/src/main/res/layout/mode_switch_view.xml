<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mode_switch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/mode_switch_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_light"
        android:contentDescription="@string/mode_switch" />

    <TextView
        android:id="@+id/mode_switch_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:text="@string/placeholder_dash" />

    <TextView
        android:id="@+id/mode_switch_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#AAAAAA"
        android:text="" />
</LinearLayout>
