<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    displayName="@string/app_name"
    icon="@drawable/ic_firefly"
    id="karoo-light-controller">

    <DataType
        typeId="light-status"
        displayName="@string/light_status"
        description="@string/light_status_desc"
        graphical="true"
        icon="@drawable/ic_light" />

    <DataType
        typeId="light-battery"
        displayName="@string/light_battery"
        description="@string/light_battery_desc"
        graphical="true"
        icon="@drawable/ic_light" />

    <DataType
        typeId="mode-switch"
        displayName="@string/mode_switch"
        description="@string/mode_switch_desc"
        graphical="true"
        icon="@drawable/ic_light" />

    <BonusAction
        actionId="toggle-lights"
        displayName="@string/toggle_lights" />

    <BonusAction
        actionId="cycle-mode"
        displayName="@string/cycle_mode" />
</ExtensionInfo>
